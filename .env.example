# ============================================================================
# Variables de entorno del SaaS ATS Verdulería. Copiar a .env y completar.
# ============================================================================

# --- Base de datos (Supabase Postgres) --------------------------------------
# Connection pooler (PgBouncer) para la app en runtime. pgbouncer=true evita
# prepared statements incompatibles con el pooler transaccional.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) para migraciones de Prisma.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- API --------------------------------------------------------------------
PORT=3000

# --- FEU / Surtec (facturación electrónica) ---------------------------------
# Credenciales de la cuenta PARTNER de ATS (un login sirve para todos los RUTs).
FEU_AMBIENTE="test"                 # test | produccion
FEU_USERNAME="api-feu@acme-api.com" # credenciales de TEST del correo de Surtec
FEU_PASSWORD="OiJSUzx1.DS"
# Opcional: refresh_token persistido (dura ~365 días). Si falta, se hace login.
FEU_REFRESH_TOKEN=""

# Intervalo del worker de polling de estado DGI (ms). Confirmar mínimo con Surtec.
CFE_POLLING_INTERVAL_MS=60000
