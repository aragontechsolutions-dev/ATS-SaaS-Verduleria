{
  "name": "@ats/cfe",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptador pluggable de Comprobante Fiscal Electrónico (CFE) para Uruguay. Interfaz CfeProvider + implementación FEU/Surtec. Sin dependencias (fetch nativo).",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
